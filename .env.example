# Token da Padel API (https://padelapi.org/user/api-tokens, plano Free, sem cartão).
# Lido apenas em código de servidor (src/lib/padel-api/client.ts) — nunca exposto ao cliente.
PADEL_API_TOKEN=

# URL público do sítio, sem barra final. Usado para canonical, hreflang, OpenGraph,
# robots.txt e sitemap.xml — todos precisam de URLs absolutos.
# Em produção deve ser o domínio real; se ficar vazio, cai no domínio da Vercel.
NEXT_PUBLIC_SITE_URL=https://padel-ten-ivory.vercel.app
